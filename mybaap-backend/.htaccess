<IfModule mod_rewrite.c>
    RewriteEngine On

    # Browser URL se /public hatao
    RewriteCond %{THE_REQUEST} \s/public/([^\s?]*) [NC]
    RewriteRule ^public/(.*)$ /$1 [R=301,L,QSA]

    # Request andar public folder me jaaye
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
